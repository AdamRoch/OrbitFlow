# Copy to .env and enter only credentials authorized for this new application.
# Never copy the old application's .env or Telegram bot token.
PORT=4310
PREVIEW_PORT=4312
DATABASE_URL=postgres://orbitflow:orbitflow-local@127.0.0.1:54329/orbitflow_v2
ORBITFLOW_MODEL=anthropic/claude-sonnet-4-5
# Set only after Adam authorizes a bounded application-provider spending budget.
ORBITFLOW_PROVIDER_BUDGET_USD=0
ANTHROPIC_API_KEY=
# Other supported provider credentials: OPENAI_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY, OPENROUTER_API_KEY
# A separate Telegram bot and one allowed chat. Do not reuse the old app's bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=

# Optional separate default for Reviewer roles; each agent remains editable in the UI.
# ORBITFLOW_REVIEWER_MODEL=openrouter/openai/gpt-5.4
