# Required for the PostgreSQL service and migration connection.
POSTGRES_DB=orbitfactory
POSTGRES_USER=orbitfactory
POSTGRES_PASSWORD=replace-with-a-local-password

# Required by the web app's operator authentication.
ORBITFLOW_OPERATOR_USERNAME=operator
ORBITFLOW_OPERATOR_PASSWORD=replace-with-a-local-operator-password

# The only evaluator provider credential. It is passed at runtime, never built into an image.
OPENROUTER_API_KEY=replace-with-an-openrouter-api-key

# Required only with `docker compose --profile telegram up --build`. This token
# belongs to grammY; OpenClaw's Telegram integration remains explicitly disabled.
TELEGRAM_BOT_TOKEN=
# Optional comma-separated Telegram chat ids. Blank allows every chat.
ORBITFLOW_TELEGRAM_ALLOWED_CHAT_IDS=

# Host ports for the app and engine readiness endpoint.
ORBITFACTORY_APP_PORT=3000
# The engine always listens on internal container port 3001. This only selects
# its localhost host publication.
ORBITFACTORY_ENGINE_HOST_PORT=3001
