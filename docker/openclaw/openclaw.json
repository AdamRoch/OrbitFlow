{
  "gateway": {
    "reload": {
      "mode": "hot"
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "z-ai/glm-5.3",
            "name": "Z.ai GLM 5.3",
            "reasoning": true,
            "input": ["text"],
            "cost": {
              "input": 1.4,
              "output": 4.4,
              "cacheRead": 0.26,
              "cacheWrite": 0
            },
            "contextWindow": 1048576,
            "maxTokens": 131072
          },
          {
            "id": "z-ai/glm-5.3-flash",
            "name": "Z.ai GLM 5.3 Flash",
            "reasoning": true,
            "input": ["text"],
            "cost": {
              "input": 0.075,
              "output": 0.25,
              "cacheRead": 0.015,
              "cacheWrite": 0
            },
            "contextWindow": 1048576,
            "maxTokens": 131072
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "timeoutSeconds": 720,
      "model": {
        "primary": "openrouter/z-ai/glm-5.3-flash"
      },
      "models": {
        "openrouter/z-ai/glm-5.3": {},
        "openrouter/z-ai/glm-5.3-flash": {}
      }
    }
  },
  "tools": {
    "profile": "minimal",
    "allow": ["exec"],
    "exec": {
      "host": "gateway",
      "security": "allowlist",
      "ask": "off",
      "strictInlineEval": true
    }
  },
  "channels": {
    "telegram": {
      "enabled": false
    }
  }
}
