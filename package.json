{
  "name": "orbitfactory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:app && npm run test:phase0 && npm run test:coding-adapter",
    "test:app": "vitest run",
    "test:phase0": "node --test test/*.test.mjs",
    "test:coding-adapter": "npm --prefix coding-adapter test",
    "test:postgres": "node --test test/postgres/schema.test.mjs",
    "test:message-bus": "node --experimental-strip-types --test test/postgres/message-bus.test.mjs",
    "test:workflow-engine": "node --experimental-strip-types --test test/postgres/workflow-engine.test.mjs",
    "test:runtime-adapter": "node --experimental-strip-types --test test/postgres/openclaw-runtime-adapter.test.mjs",
    "fact8:proof": "bash scripts/fact-8-postgres-proof.sh",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "fact6:proof": "bash scripts/fact-6-postgres-proof.sh",
    "fact12:proof": "bash scripts/fact-12-coding-adapter-proof.sh",
    "fact9:proof": "bash scripts/fact-9-message-bus-proof.sh",
    "fact13:proof": "bash scripts/fact-13-platform-tool-proof.sh",
    "fact41:proof": "bash scripts/fact-41-ticket-dispatch-proof.sh",
    "fact10:proof": "bash scripts/fact-10-workflow-engine-proof.sh",
    "fact11:proof": "bash scripts/fact-11-runtime-adapter-proof.sh",
    "fact14:proof": "bash scripts/fact-14-e2e-proof.sh",
    "fact22:proof": "bash scripts/fact-22-monitoring-proof.sh",
    "test:guardrails": "node --experimental-strip-types --test test/postgres/guardrails.test.mjs",
    "fact23:proof": "bash scripts/fact-23-guardrails-proof.sh",
    "fact21:proof": "bash scripts/fact-21-workflow-templates-proof.sh",
    "test:telegram": "node --experimental-strip-types --test test/postgres/telegram.test.mjs",
    "test:scheduling": "node --experimental-strip-types --test test/postgres/scheduling.test.mjs",
    "fact15:proof": "bash scripts/fact-15-telegram-proof.sh",
    "fact25:proof": "bash scripts/fact-25-scheduling-proof.sh",
    "fact26:proof": "bash scripts/fact-26-critical-paths-proof.sh",
    "test:channel-intake": "node --experimental-strip-types --test test/postgres/channel-intake.test.mjs",
    "fact16:proof": "bash scripts/fact-16-channel-intake-proof.sh",
    "test:channel-status-reports": "node --experimental-strip-types --test test/postgres/channel-status-reports.test.mjs",
    "fact17:proof": "bash scripts/fact-17-status-reports-proof.sh",
    "test:templates": "node --experimental-strip-types --test test/postgres/workflow-templates.test.mjs",
    "test:state-stream": "node --experimental-strip-types --test test/postgres/state-stream.test.mjs",
    "fact18:proof": "bash scripts/fact-18-state-stream-proof.sh",
    "fact24:proof": "bash scripts/fact-24-workflow-questions-proof.sh",
    "fact37:proof": "bash scripts/fact-37-telegram-clarification-proof.sh",
    "fact31:proof": "bash scripts/fact-31-compose-proof.sh",
    "fact34:postgres-proof": "bash scripts/fact-34-postgres-proof.sh",
    "fact34:compose-proof": "bash scripts/fact-34-compose-proof.sh",
    "fact34:proof": "npm run fact34:postgres-proof && npm run fact34:compose-proof",
    "fact34:funded-run": "bash scripts/fact-34-funded-dry-run.sh",
    "fact35:proof": "bash scripts/fact-35-model-catalog-proof.sh",
    "fact36:proof": "bash scripts/fact-36-factory-project-proof.sh",
    "factory:export": "node bin/orbit-export-factory-workspace.mjs",
    "fact38:proof": "bash scripts/fact-38-workspace-export-proof.sh",
    "fact1:spike": "node scripts/fact-1-openclaw-spike.mjs",
    "fact2:spike": "node scripts/fact-2-platform-tool-spike.mjs",
    "coding-tool": "node bin/orbit-coding-tool.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "grammy": "^1.45.1",
    "lucide-react": "^1.24.0",
    "next": "16.3.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
