{
  "name": "orbitflow-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server/index.ts",
    "web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=postgres://orbitflow:orbitflow-local@127.0.0.1:54329/orbitflow tsx --test tests/*.test.ts",
    "setup": "bash scripts/setup.sh"
  },
  "dependencies": {
    "cron-parser": "5.3.1",
    "express": "5.2.1",
    "pg": "8.16.3",
    "railway": "3.11.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "esbuild": "0.25.12",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.6"
  }
}
