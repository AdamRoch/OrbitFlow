{
  "name": "orbitfactory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:app && npm run test:phase0 && npm run test:coding-adapter",
    "test:app": "vitest run",
    "test:phase0": "node --test test/*.test.mjs",
    "test:coding-adapter": "npm --prefix coding-adapter test",
    "test:postgres": "node --test test/postgres/schema.test.mjs",
    "test:message-bus": "node --experimental-strip-types --test test/postgres/message-bus.test.mjs",
    "test:workflow-engine": "node --experimental-strip-types --test test/postgres/workflow-engine.test.mjs",
    "test:runtime-adapter": "node --experimental-strip-types --test test/postgres/openclaw-runtime-adapter.test.mjs",
    "fact8:proof": "bash scripts/fact-8-postgres-proof.sh",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "fact6:proof": "bash scripts/fact-6-postgres-proof.sh",
    "fact12:proof": "bash scripts/fact-12-coding-adapter-proof.sh",
    "fact9:proof": "bash scripts/fact-9-message-bus-proof.sh",
    "fact10:proof": "bash scripts/fact-10-workflow-engine-proof.sh",
    "fact11:proof": "bash scripts/fact-11-runtime-adapter-proof.sh",
    "test:state-stream": "node --experimental-strip-types --test test/postgres/state-stream.test.mjs",
    "fact18:proof": "bash scripts/fact-18-state-stream-proof.sh",
    "fact1:spike": "node scripts/fact-1-openclaw-spike.mjs",
    "fact2:spike": "node scripts/fact-2-platform-tool-spike.mjs",
    "coding-tool": "node bin/orbit-coding-tool.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.24.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
